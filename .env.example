# Database connection string (Supabase Postgres)
DATABASE_URL=postgresql://postgres.utovtmjidolbuwtjtwnq:shiva%408328545777@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Firebase Service Account configuration
# Option A: Path to the downloaded service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: Stringified JSON of the service account key (useful for cloud deployments like Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# OneDrive reports configuration
# The path where reports will be generated. Since the workspace folder is synced to OneDrive,
# saving reports here automatically syncs them.
ONEDRIVE_REPORT_PATH=./onedrive_reports

# Sync configurations
SYNC_INTERVAL_MINUTES=60

# Safe list of tables to clear from Supabase after successful backup to Firebase and OneDrive.
# By default, only logs and transaction tables are cleared. Master/config tables are preserved.
TABLES_TO_DELETE=activity_logs,attendance,chat_messages,ptm_conversations,homework_submissions,relieving_requests,cross_class_requests

# Automatically start the background sync daemon when server.js boots
AUTO_START_SYNC=false
